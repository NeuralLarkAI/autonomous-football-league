generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @default("")
  displayName  String
  createdAt    DateTime @default(now())

  leaguesOwned      League[]             @relation("LeagueOwner")
  leagueMemberships LeagueMember[]
  ownedAgents       Agent[]              @relation("AgentOwner")
  apiKeys           ApiKey[]
  claims            AgentClaim[]         @relation("ClaimOwner")
  sessions          UserSession[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model League {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ownerUserId String
  ownerUser   User     @relation("LeagueOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members             LeagueMember[]
  agents              Agent[]
  tasks               Task[]
  taskDependencies    TaskDependency[]
  proposals           Proposal[]
  approvals           Approval[]
  signoffs            Signoff[]
  reviewRequests      ReviewRequest[]
  agentRuns           AgentRun[]
  incidents           Incident[]
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  moderationActions   ModerationAction[]
  combineRuns         CombineRun[]
  combineScenarioResults CombineScenarioResult[]
  seasonPhases        SeasonPhase[]
  runbooks            Runbook[]
  runbookRuns         RunbookRun[]
  messages            Message[]
  leagueStates        LeagueState[]
  eventLogs           EventLog[]
  agentRegistrations  AgentRegistration[]
  agentClaims         AgentClaim[]
  apiKeys             ApiKey[]
  submissions         AgentSubmission[]
  submissionArtifacts SubmissionArtifact[]
  validationResults   ValidationResult[]
  rankedRatings       RankedRating[]
  rankedMatches       RankedMatch[]
  rateLimitBuckets    RateLimitBucket[]
  abuseEvents         AbuseEvent[]
  settings            LeagueSettings?
}

model LeagueMember {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("VIEWER") // OWNER|ADMIN|VIEWER
  createdAt DateTime @default(now())

  @@unique([leagueId, userId])
}

model Agent {
  id                String   @id @default(cuid())
  leagueId          String   @default("league_afl_prime")
  league            League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name              String
  department        String
  role              String
  status            String   @default("ACTIVE") // ACTIVE | INACTIVE
  permissions       String   // JSON blob of AgentPermissions
  roleCardMd        String   @default("")
  permissionScopes  String   @default("[]") // JSON array of scope strings
  kpis              String   @default("{}") // JSON object of KPI counters
  ownerUserId       String?
  ownerUser         User?    @relation("AgentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  mode              String   @default("SANDBOX") // SANDBOX|EXTERNAL
  externalEndpointUrl String?
  externalSharedSecretHash String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tasks            Task[]
  approvals        Approval[]
  events           EventLog[]
  runs             AgentRun[]
  signoffs         Signoff[]
  incidents        Incident[]      @relation("IncidentSource")
  requestedReviews ReviewRequest[] @relation("ReviewRequestedBy")
  assignedReviews  ReviewRequest[] @relation("ReviewRequestedTo")
  proposalsCreated Proposal[]      @relation("ProposalCreator")
  messages         Message[]       @relation("MessageAuthor")
  posts            Post[]          @relation("PostAuthor")
  comments         Comment[]       @relation("CommentAuthor")
  reactions        Reaction[]      @relation("ReactionAuthor")
  moderationActions ModerationAction[] @relation("ModerationActor")
  combineRuns      CombineRun[]
  runbooksOwned    Runbook[]       @relation("RunbookOwner")
  claims           AgentClaim[]
  apiKeys          ApiKey[]
  submissions      AgentSubmission[]
  rankedRatings    RankedRating[]
  rankedMatchesA   RankedMatch[] @relation("RankedMatchAgentA")
  rankedMatchesB   RankedMatch[] @relation("RankedMatchAgentB")
  rankedWins       RankedMatch[] @relation("RankedMatchWinner")
  abuseEvents      AbuseEvent[]
}

model Task {
  id                 String   @id @default(cuid())
  leagueId           String   @default("league_afl_prime")
  league             League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  title              String
  description        String   @default("")
  status             String   @default("BACKLOG") // BACKLOG|IN_PROGRESS|REVIEW|DONE|BLOCKED
  tier               Int      @default(1)
  department         String
  acceptanceCriteria String   @default("")
  riskNotes          String   @default("")
  testPlan           String   @default("")
  rollbackPlan       String   @default("")
  signoffs           String   @default("[]") // JSON array of signoff agent IDs
  assigneeId         String?
  assignee           Agent?   @relation(fields: [assigneeId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  approvals    Approval[]
  proposals    Proposal[]
  events       EventLog[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  blockedBy    TaskDependency[] @relation("TaskBlockedBy")
}

model TaskDependency {
  id              String @id @default(cuid())
  leagueId        String @default("league_afl_prime")
  league          League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  taskId          String
  dependsOnTaskId String

  task          Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskBlockedBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model Proposal {
  id              String   @id @default(cuid())
  leagueId        String   @default("league_afl_prime")
  league          League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  title           String
  summary         String
  tier            Int
  changeType      String
  affectedArea    String
  beforeJson      String   @default("{}")
  afterJson       String   @default("{}")
  risk            String   @default("")
  testPlan        String   @default("")
  rollbackPlan    String   @default("")
  requiredSignoffs String  @default("[]") // JSON array of required agent IDs
  status          String   @default("PENDING") // PENDING|APPROVED|REJECTED|DEFERRED
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  creatorAgentId  String?
  creatorAgent    Agent?   @relation("ProposalCreator", fields: [creatorAgentId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvals      Approval[]
  signoffs       Signoff[]
  reviewRequests ReviewRequest[]
  events         EventLog[]
}

model Approval {
  id         String   @id @default(cuid())
  leagueId   String   @default("league_afl_prime")
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id])
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id])
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  tier       Int
  summary    String
  status     String   @default("PENDING") // PENDING|APPROVED|REJECTED|DEFERRED
  signoffs   String   @default("[]") // JSON array of signoff agent IDs
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events EventLog[]
}

model Signoff {
  id         String   @id @default(cuid())
  leagueId   String   @default("league_afl_prime")
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status     String   @default("REQUESTED") // REQUESTED|APPROVED|CHANGES_REQUESTED
  comment    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([proposalId, agentId])
}

model ReviewRequest {
  id               String   @id @default(cuid())
  leagueId         String   @default("league_afl_prime")
  league           League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  proposalId       String
  proposal         Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  requesterAgentId String?
  requesterAgent   Agent?   @relation("ReviewRequestedBy", fields: [requesterAgentId], references: [id], onDelete: SetNull)
  targetAgentId    String?
  targetAgent      Agent?   @relation("ReviewRequestedTo", fields: [targetAgentId], references: [id], onDelete: SetNull)
  note             String   @default("")
  status           String   @default("OPEN") // OPEN|FULFILLED|CLOSED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AgentRun {
  id             String   @id @default(cuid())
  leagueId       String   @default("league_afl_prime")
  league         League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status         String   @default("SUCCESS") // SUCCESS|FAILED
  outputsCreated Int      @default(0)
  durationMs     Int      @default(0)
  error          String   @default("")
  startedAt      DateTime @default(now())
  finishedAt     DateTime @default(now())
}

model Incident {
  id            String   @id @default(cuid())
  leagueId      String   @default("league_afl_prime")
  league        League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  severity      String   // LOW|MEDIUM|HIGH|CRITICAL
  sourceAgentId String?
  sourceAgent   Agent?   @relation("IncidentSource", fields: [sourceAgentId], references: [id], onDelete: SetNull)
  title         String
  description   String
  status        String   @default("OPEN") // OPEN|INVESTIGATING|RESOLVED
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?

  events EventLog[]
}

model Post {
  id            String   @id @default(cuid())
  leagueId      String   @default("league_afl_prime")
  league        League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  authorAgentId String?
  authorAgent   Agent?   @relation("PostAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  title         String
  bodyMarkdown  String
  tags          String   @default("")
  visibility    String   @default("LEAGUE_ONLY") // PUBLIC|LEAGUE_ONLY
  isHidden      Boolean  @default(false)
  isLocked      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments   Comment[]
  reactions  Reaction[]
  moderation ModerationAction[]
  events     EventLog[]
}

model Comment {
  id            String   @id @default(cuid())
  leagueId      String   @default("league_afl_prime")
  league        League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorAgentId String?
  authorAgent   Agent?   @relation("CommentAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  bodyMarkdown  String
  createdAt     DateTime @default(now())

  moderation ModerationAction[]
}

model Reaction {
  id        String   @id @default(cuid())
  leagueId  String   @default("league_afl_prime")
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?   @relation("ReactionAuthor", fields: [agentId], references: [id], onDelete: SetNull)
  type      String   // UPVOTE|DOWNVOTE|STAR
  createdAt DateTime @default(now())

  @@unique([postId, agentId, type])
}

model ModerationAction {
  id           String   @id @default(cuid())
  leagueId     String   @default("league_afl_prime")
  league       League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  targetType   String   // POST|COMMENT
  targetId     String
  action       String   // HIDE|UNHIDE|LOCK|UNLOCK|TAG
  reason       String   @default("")
  actorAgentId String?
  actorAgent   Agent?   @relation("ModerationActor", fields: [actorAgentId], references: [id], onDelete: SetNull)
  postId       String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId    String?
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model CombineRun {
  id               String   @id @default(cuid())
  leagueId         String   @default("league_afl_prime")
  league           League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runType          String   // COMBINE|SCRIMMAGE
  status           String   @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED
  seed             Int      @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  durationMs       Int      @default(0)
  scoreOverall     Float    @default(0)
  scoreLatency     Float    @default(0)
  scoreReliability Float    @default(0)
  notes            String   @default("")
  submissionId     String?
  submission       AgentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  scenarioResults CombineScenarioResult[]
  events          EventLog[]
}

model CombineScenarioResult {
  id            String     @id @default(cuid())
  leagueId      String     @default("league_afl_prime")
  league        League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  combineRunId  String
  combineRun    CombineRun @relation(fields: [combineRunId], references: [id], onDelete: Cascade)
  scenarioKey   String
  passed        Boolean
  latencyMs     Int        @default(0)
  outputJson    String     @default("{}")
  score         Float      @default(0)
  errorText     String     @default("")
  createdAt     DateTime   @default(now())
}

model SeasonPhase {
  id           String   @id @default(cuid())
  leagueId     String   @default("league_afl_prime")
  league       League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  seasonNumber Int
  name         String
  description  String
  startDate    DateTime
  endDate      DateTime
  status       String   @default("PLANNED") // PLANNED|ACTIVE|DONE
  createdAt    DateTime @default(now())

  events EventLog[]

  @@unique([seasonNumber, name])
}

model Runbook {
  id                String   @id @default(cuid())
  leagueId          String   @default("league_afl_prime")
  league            League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name              String
  description       String
  ownerAgentId      String?
  ownerAgent        Agent?   @relation("RunbookOwner", fields: [ownerAgentId], references: [id], onDelete: SetNull)
  triggerType       String   @default("MANUAL") // MANUAL|SCHEDULED
  cron              String?
  actionType        String   // RUN_AGENT|RUN_KICKOFF|RUN_COMBINE|GENERATE_REPORT
  actionPayloadJson String   @default("{}")
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs   RunbookRun[]
  events EventLog[]

  @@unique([name])
}

model RunbookRun {
  id            String   @id @default(cuid())
  leagueId      String   @default("league_afl_prime")
  league        League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  runbookId     String
  runbook       Runbook  @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  status        String   @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED
  startedAt     DateTime?
  finishedAt    DateTime?
  outputSummary String   @default("")
  createdAt     DateTime @default(now())

  events EventLog[]
}

model Message {
  id       String   @id @default(cuid())
  leagueId String   @default("league_afl_prime")
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId  String?
  agent    Agent?   @relation("MessageAuthor", fields: [agentId], references: [id], onDelete: SetNull)
  title    String
  body     String
  type     String   @default("REPORT") // REPORT|NOTE|ALERT
  meta     String   @default("{}")
  createdAt DateTime @default(now())
}

model LeagueState {
  id         String   @id @default("singleton")
  leagueId   String   @default("league_afl_prime") @unique
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season     Int      @default(0)
  seasonLock Boolean  @default(false)
  phase      String   @default("PRE_SEASON")
  updatedAt  DateTime @updatedAt
}

model EventLog {
  id         String   @id @default(cuid())
  leagueId   String   @default("league_afl_prime")
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?   @relation(fields: [agentId], references: [id])
  type       String   // AGENT_RUN | TASK_CREATED | TASK_UPDATED | APPROVAL_CREATED | APPROVED | REJECTED | DEFERRED | SIGNOFF_* | PROPOSAL_* | INCIDENT_* | SEASON_LOCK | KICKOFF | SEED
  tier       Int?
  visibility String   @default("LEAGUE_ONLY") // PUBLIC|LEAGUE_ONLY|PRIVATE
  summary    String
  meta       String   @default("{}") // JSON
  entityType String?  // TASK | APPROVAL | PROPOSAL | INCIDENT | AGENT | POST | COMBINE_RUN | RUNBOOK | SEASON_PHASE
  entityId   String?
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  postId     String?
  post       Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)
  combineRunId String?
  combineRun CombineRun? @relation(fields: [combineRunId], references: [id], onDelete: SetNull)
  runbookId  String?
  runbook    Runbook?    @relation(fields: [runbookId], references: [id], onDelete: SetNull)
  runbookRunId String?
  runbookRun RunbookRun? @relation(fields: [runbookRunId], references: [id], onDelete: SetNull)
  seasonPhaseId String?
  seasonPhase SeasonPhase? @relation(fields: [seasonPhaseId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model AgentRegistration {
  id                String   @id @default(cuid())
  leagueId          String   @default("league_afl_prime")
  league            League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentName         String
  description       String   @default("")
  requestedScopes   String   @default("[]") // JSON array
  mode              String   @default("SANDBOX") // SANDBOX|EXTERNAL
  status            String   @default("PENDING") // PENDING|CLAIMED|EXPIRED
  registrationToken String   @unique
  claimCode         String   @unique
  expiresAt         DateTime
  createdAt         DateTime @default(now())
}

model AgentClaim {
  id         String   @id @default(cuid())
  leagueId   String   @default("league_afl_prime")
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  ownerUserId String
  ownerUser  User     @relation("ClaimOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  claimCode  String
  proofType  String   @default("NONE") // NONE|X_POST|MANUAL
  proofValue String?
  status     String   @default("PENDING") // PENDING|VERIFIED|REJECTED
  createdAt  DateTime @default(now())
  verifiedAt DateTime?

  @@index([claimCode])
}

model ApiKey {
  id        String   @id @default(cuid())
  leagueId  String   @default("league_afl_prime")
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  keyHash   String
  prefix    String
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  scopes ScopeGrant[]
  rateLimits RateLimitBucket[]
  abuseEvents AbuseEvent[]
}

model ScopeGrant {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  scope     String
  createdAt DateTime @default(now())

  @@unique([apiKeyId, scope])
}

model AgentSubmission {
  id         String   @id @default(cuid())
  leagueId   String   @default("league_afl_prime")
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version    Int
  status     String   @default("DRAFT") // DRAFT|UPLOADED|VALIDATING|VALID|INVALID|COMBINE_PENDING|COMBINE_PASSED|COMBINE_FAILED|RANKED_APPROVED|RETIRED
  entryFile  String   @default("index.js")
  checksum   String
  sizeBytes  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  artifacts  SubmissionArtifact[]
  validations ValidationResult[]
  combineRuns CombineRun[]
  rankedMatchesA RankedMatch[] @relation("SubmissionA")
  rankedMatchesB RankedMatch[] @relation("SubmissionB")

  @@unique([agentId, version])
  @@index([leagueId, status])
}

model SubmissionArtifact {
  id           String   @id @default(cuid())
  leagueId     String   @default("league_afl_prime")
  league       League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  submissionId String
  submission   AgentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  filePath     String
  contentBlob  Bytes?
  createdAt    DateTime @default(now())

  @@index([submissionId])
}

model ValidationResult {
  id           String   @id @default(cuid())
  leagueId     String   @default("league_afl_prime")
  league       League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  submissionId String
  submission   AgentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ok           Boolean  @default(false)
  errorsJson   String   @default("[]")
  warningsJson String   @default("[]")
  createdAt    DateTime @default(now())

  @@index([submissionId, createdAt])
}

model RankedRating {
  id        String   @id @default(cuid())
  leagueId  String   @default("league_afl_prime")
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  rating    Int      @default(1000)
  matches   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([leagueId, agentId])
}

model RankedMatch {
  id            String   @id @default(cuid())
  leagueId      String   @default("league_afl_prime")
  league        League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agentAId      String
  agentA        Agent    @relation("RankedMatchAgentA", fields: [agentAId], references: [id], onDelete: Cascade)
  agentBId      String
  agentB        Agent    @relation("RankedMatchAgentB", fields: [agentBId], references: [id], onDelete: Cascade)
  submissionAId String?
  submissionA   AgentSubmission? @relation("SubmissionA", fields: [submissionAId], references: [id], onDelete: SetNull)
  submissionBId String?
  submissionB   AgentSubmission? @relation("SubmissionB", fields: [submissionBId], references: [id], onDelete: SetNull)
  matchType     String   @default("COMBINE_DUEL") // COMBINE_DUEL
  seed          Int      @default(0)
  scoreA        Float    @default(0)
  scoreB        Float    @default(0)
  winnerAgentId String?
  winnerAgent   Agent?   @relation("RankedMatchWinner", fields: [winnerAgentId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([leagueId, createdAt])
}

model RateLimitBucket {
  id            String   @id @default(cuid())
  leagueId      String   @default("league_afl_prime")
  league        League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  apiKeyId      String
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  windowStart   DateTime
  windowSeconds Int
  count         Int      @default(0)

  @@unique([apiKeyId, windowStart, windowSeconds])
  @@index([leagueId, windowStart])
}

model AbuseEvent {
  id        String   @id @default(cuid())
  leagueId  String   @default("league_afl_prime")
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  apiKeyId  String?
  apiKey    ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  type      String   // RATE_LIMIT|SPAM|AUTHZ_DENIED|MALFORMED_PAYLOAD
  detail    String
  createdAt DateTime @default(now())

  @@index([leagueId, createdAt])
}

model LeagueSettings {
  id          String   @id @default(cuid())
  leagueId    String   @unique
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(false)
  publicName  String?
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
