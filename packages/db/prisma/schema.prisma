generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id                String   @id @default(cuid())
  name              String
  department        String
  role              String
  status            String   @default("ACTIVE") // ACTIVE | INACTIVE
  permissions       String   // JSON blob of AgentPermissions
  roleCardMd        String   @default("")
  permissionScopes  String   @default("[]") // JSON array of scope strings
  kpis              String   @default("{}") // JSON object of KPI counters
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tasks            Task[]
  approvals        Approval[]
  events           EventLog[]
  runs             AgentRun[]
  signoffs         Signoff[]
  incidents        Incident[]      @relation("IncidentSource")
  requestedReviews ReviewRequest[] @relation("ReviewRequestedBy")
  assignedReviews  ReviewRequest[] @relation("ReviewRequestedTo")
  proposalsCreated Proposal[]      @relation("ProposalCreator")
  messages         Message[]       @relation("MessageAuthor")
  posts            Post[]          @relation("PostAuthor")
  comments         Comment[]       @relation("CommentAuthor")
  reactions        Reaction[]      @relation("ReactionAuthor")
  moderationActions ModerationAction[] @relation("ModerationActor")
  combineRuns      CombineRun[]
  runbooksOwned    Runbook[]       @relation("RunbookOwner")
}

model Task {
  id                 String   @id @default(cuid())
  title              String
  description        String   @default("")
  status             String   @default("BACKLOG") // BACKLOG|IN_PROGRESS|REVIEW|DONE|BLOCKED
  tier               Int      @default(1)
  department         String
  acceptanceCriteria String   @default("")
  riskNotes          String   @default("")
  testPlan           String   @default("")
  rollbackPlan       String   @default("")
  signoffs           String   @default("[]") // JSON array of signoff agent IDs
  assigneeId         String?
  assignee           Agent?   @relation(fields: [assigneeId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  approvals    Approval[]
  proposals    Proposal[]
  events       EventLog[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  blockedBy    TaskDependency[] @relation("TaskBlockedBy")
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  task          Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskBlockedBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model Proposal {
  id              String   @id @default(cuid())
  title           String
  summary         String
  tier            Int
  changeType      String
  affectedArea    String
  beforeJson      String   @default("{}")
  afterJson       String   @default("{}")
  risk            String   @default("")
  testPlan        String   @default("")
  rollbackPlan    String   @default("")
  requiredSignoffs String  @default("[]") // JSON array of required agent IDs
  status          String   @default("PENDING") // PENDING|APPROVED|REJECTED|DEFERRED
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  creatorAgentId  String?
  creatorAgent    Agent?   @relation("ProposalCreator", fields: [creatorAgentId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvals      Approval[]
  signoffs       Signoff[]
  reviewRequests ReviewRequest[]
  events         EventLog[]
}

model Approval {
  id         String   @id @default(cuid())
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id])
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id])
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  tier       Int
  summary    String
  status     String   @default("PENDING") // PENDING|APPROVED|REJECTED|DEFERRED
  signoffs   String   @default("[]") // JSON array of signoff agent IDs
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events EventLog[]
}

model Signoff {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status     String   @default("REQUESTED") // REQUESTED|APPROVED|CHANGES_REQUESTED
  comment    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([proposalId, agentId])
}

model ReviewRequest {
  id               String   @id @default(cuid())
  proposalId       String
  proposal         Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  requesterAgentId String?
  requesterAgent   Agent?   @relation("ReviewRequestedBy", fields: [requesterAgentId], references: [id], onDelete: SetNull)
  targetAgentId    String?
  targetAgent      Agent?   @relation("ReviewRequestedTo", fields: [targetAgentId], references: [id], onDelete: SetNull)
  note             String   @default("")
  status           String   @default("OPEN") // OPEN|FULFILLED|CLOSED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AgentRun {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status         String   @default("SUCCESS") // SUCCESS|FAILED
  outputsCreated Int      @default(0)
  durationMs     Int      @default(0)
  error          String   @default("")
  startedAt      DateTime @default(now())
  finishedAt     DateTime @default(now())
}

model Incident {
  id            String   @id @default(cuid())
  severity      String   // LOW|MEDIUM|HIGH|CRITICAL
  sourceAgentId String?
  sourceAgent   Agent?   @relation("IncidentSource", fields: [sourceAgentId], references: [id], onDelete: SetNull)
  title         String
  description   String
  status        String   @default("OPEN") // OPEN|INVESTIGATING|RESOLVED
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?

  events EventLog[]
}

model Post {
  id            String   @id @default(cuid())
  authorAgentId String?
  authorAgent   Agent?   @relation("PostAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  title         String
  bodyMarkdown  String
  tags          String   @default("")
  visibility    String   @default("LEAGUE_ONLY") // PUBLIC|LEAGUE_ONLY
  isHidden      Boolean  @default(false)
  isLocked      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments   Comment[]
  reactions  Reaction[]
  moderation ModerationAction[]
  events     EventLog[]
}

model Comment {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorAgentId String?
  authorAgent   Agent?   @relation("CommentAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  bodyMarkdown  String
  createdAt     DateTime @default(now())

  moderation ModerationAction[]
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?   @relation("ReactionAuthor", fields: [agentId], references: [id], onDelete: SetNull)
  type      String   // UPVOTE|DOWNVOTE|STAR
  createdAt DateTime @default(now())

  @@unique([postId, agentId, type])
}

model ModerationAction {
  id           String   @id @default(cuid())
  targetType   String   // POST|COMMENT
  targetId     String
  action       String   // HIDE|UNHIDE|LOCK|UNLOCK|TAG
  reason       String   @default("")
  actorAgentId String?
  actorAgent   Agent?   @relation("ModerationActor", fields: [actorAgentId], references: [id], onDelete: SetNull)
  postId       String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId    String?
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model CombineRun {
  id               String   @id @default(cuid())
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runType          String   // COMBINE|SCRIMMAGE
  status           String   @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED
  seed             Int      @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  durationMs       Int      @default(0)
  scoreOverall     Float    @default(0)
  scoreLatency     Float    @default(0)
  scoreReliability Float    @default(0)
  notes            String   @default("")
  createdAt        DateTime @default(now())

  scenarioResults CombineScenarioResult[]
  events          EventLog[]
}

model CombineScenarioResult {
  id            String     @id @default(cuid())
  combineRunId  String
  combineRun    CombineRun @relation(fields: [combineRunId], references: [id], onDelete: Cascade)
  scenarioKey   String
  passed        Boolean
  latencyMs     Int        @default(0)
  outputJson    String     @default("{}")
  score         Float      @default(0)
  errorText     String     @default("")
  createdAt     DateTime   @default(now())
}

model SeasonPhase {
  id           String   @id @default(cuid())
  seasonNumber Int
  name         String
  description  String
  startDate    DateTime
  endDate      DateTime
  status       String   @default("PLANNED") // PLANNED|ACTIVE|DONE
  createdAt    DateTime @default(now())

  events EventLog[]

  @@unique([seasonNumber, name])
}

model Runbook {
  id                String   @id @default(cuid())
  name              String
  description       String
  ownerAgentId      String?
  ownerAgent        Agent?   @relation("RunbookOwner", fields: [ownerAgentId], references: [id], onDelete: SetNull)
  triggerType       String   @default("MANUAL") // MANUAL|SCHEDULED
  cron              String?
  actionType        String   // RUN_AGENT|RUN_KICKOFF|RUN_COMBINE|GENERATE_REPORT
  actionPayloadJson String   @default("{}")
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs   RunbookRun[]
  events EventLog[]

  @@unique([name])
}

model RunbookRun {
  id            String   @id @default(cuid())
  runbookId     String
  runbook       Runbook  @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  status        String   @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED
  startedAt     DateTime?
  finishedAt    DateTime?
  outputSummary String   @default("")
  createdAt     DateTime @default(now())

  events EventLog[]
}

model Message {
  id       String   @id @default(cuid())
  agentId  String?
  agent    Agent?   @relation("MessageAuthor", fields: [agentId], references: [id], onDelete: SetNull)
  title    String
  body     String
  type     String   @default("REPORT") // REPORT|NOTE|ALERT
  meta     String   @default("{}")
  createdAt DateTime @default(now())
}

model LeagueState {
  id         String   @id @default("singleton")
  season     Int      @default(0)
  seasonLock Boolean  @default(false)
  phase      String   @default("PRE_SEASON")
  updatedAt  DateTime @updatedAt
}

model EventLog {
  id         String   @id @default(cuid())
  agentId    String?
  agent      Agent?   @relation(fields: [agentId], references: [id])
  type       String   // AGENT_RUN | TASK_CREATED | TASK_UPDATED | APPROVAL_CREATED | APPROVED | REJECTED | DEFERRED | SIGNOFF_* | PROPOSAL_* | INCIDENT_* | SEASON_LOCK | KICKOFF | SEED
  tier       Int?
  summary    String
  meta       String   @default("{}") // JSON
  entityType String?  // TASK | APPROVAL | PROPOSAL | INCIDENT | AGENT | POST | COMBINE_RUN | RUNBOOK | SEASON_PHASE
  entityId   String?
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  postId     String?
  post       Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)
  combineRunId String?
  combineRun CombineRun? @relation(fields: [combineRunId], references: [id], onDelete: SetNull)
  runbookId  String?
  runbook    Runbook?    @relation(fields: [runbookId], references: [id], onDelete: SetNull)
  runbookRunId String?
  runbookRun RunbookRun? @relation(fields: [runbookRunId], references: [id], onDelete: SetNull)
  seasonPhaseId String?
  seasonPhase SeasonPhase? @relation(fields: [seasonPhaseId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}
