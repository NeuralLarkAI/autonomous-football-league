# Point the web app at the same SQLite file used by `packages/db`
DATABASE_URL="file:../../packages/db/dev.db"

# Optional app env
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"

# Optional AI brain (server-side only, never expose to browser)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-latest"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_MODEL_CHIEF_OF_STAFF="gpt-4.1-mini"

# AFL Vault (client-side)
NEXT_PUBLIC_AFL_VAULT_ADDRESS=""     # AFLVault contract address
NEXT_PUBLIC_AFL_TOKEN_ADDRESS=""     # $AFL token contract address
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""  # from cloud.walletconnect.com
