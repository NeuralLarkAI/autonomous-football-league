{
  "name": "autonomous-football-league",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "corepack pnpm --filter @afl/web dev",
    "build": "corepack pnpm --filter @afl/web build",
    "start:web": "node scripts/start-web.cjs",
    "start:worker": "corepack pnpm exec tsx scripts/worker.ts",
    "lint": "corepack pnpm --filter @afl/web lint",
    "db:generate": "corepack pnpm --filter @afl/db prisma:generate",
    "db:migrate": "corepack pnpm --filter @afl/db prisma:migrate",
    "db:seed": "corepack pnpm --filter @afl/db seed",
    "db:studio": "corepack pnpm --filter @afl/db prisma:studio",
    "seed": "corepack pnpm --filter @afl/db seed",
    "_dev": "cd apps/web && corepack pnpm dev",
    "_db:migrate": "cd packages/db && corepack pnpm prisma:migrate",
    "_seed": "cd packages/db && corepack pnpm seed",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "smoke:external-ui": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-external-ui.ps1",
    "qa:phase0": "corepack pnpm --filter @afl/web exec tsc --noEmit && corepack pnpm smoke:external-ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  }
}
