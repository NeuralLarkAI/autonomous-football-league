{
  "name": "autonomous-football-league",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "corepack pnpm --filter @afl/web dev",
    "build": "corepack pnpm --filter @afl/web build",
    "lint": "corepack pnpm --filter @afl/web lint",
    "db:generate": "corepack pnpm --filter @afl/db prisma:generate",
    "db:migrate": "corepack pnpm --filter @afl/db prisma:migrate",
    "db:seed": "corepack pnpm --filter @afl/db seed",
    "db:studio": "corepack pnpm --filter @afl/db prisma:studio",
    "seed": "corepack pnpm --filter @afl/db seed",
    "_dev": "cd apps/web && corepack pnpm dev",
    "_db:migrate": "cd packages/db && corepack pnpm prisma:migrate",
    "_seed": "cd packages/db && corepack pnpm seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
