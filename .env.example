# Local dev (SQLite)
DATABASE_URL="file:./dev.db"

# Optional app env
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"

# Optional AI brain (server-side only, never expose to browser)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-latest"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_MODEL_CHIEF_OF_STAFF="gpt-4.1-mini"

# AI cost controls (defaults are already safe in code)
# Chief of Staff OpenAI planning is only used for backlog refill when open tasks drop below threshold.
AFL_CHIEF_OF_STAFF_OPENAI_ENABLED="true"
AFL_CHIEF_OF_STAFF_AI_MIN_INTERVAL_SECONDS="1800"

# Commissioner Claude decision-making is only used when there are pending approvals/proposals/incidents
# and the state has changed since the last decision.
AFL_COMMISSIONER_CLAUDE_ENABLED="true"
AFL_COMMISSIONER_AI_MIN_INTERVAL_SECONDS="1800"
AFL_COMMISSIONER_AI_REQUIRE_SIGNAL="true"
AFL_COMMISSIONER_AI_STATE_CHANGE_ONLY="true"

# Debug-only: emits AGENT_AI_SKIPPED events for gated calls
AFL_AI_LOG_SKIPS="false"

# Production example (Postgres)
# DATABASE_URL="postgresql://user:password@host:5432/autonomous_football_league?schema=public"
